# 服务端口
PORT=3000

# 允许跨域访问的前端来源，多个用英文逗号分隔。
# 同时保留 localhost 与 127.0.0.1，避免浏览器用不同写法访问时被 CORS 拦截。
# 阶段3.3.3：生产环境（NODE_ENV=production）填 * 会被后端直接剔除并给出启动告警，
# 这里必须写真实前端域名；开发环境填 * 能用，但只适合本地调试。
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 运行环境：development | production
NODE_ENV=development

# 数据库连接串（阶段3.1 新增，示例值，不要填真实密码）。
# 真实值只写在 apps/server/.env，该文件已被 .gitignore 排除。
#
# provider 为 mysql，格式：mysql://用户:密码@主机:端口/库名
# 本机现状：原有 MySQL 5.7.44 监听 3306（未动）；本项目并行安装的 MySQL 8.4.13 监听 3307，只绑 127.0.0.1。
# 默认注释掉：没配数据库时接口会如实返回「未配置」，不伪造连接成功。
# DATABASE_URL="mysql://campusgo:在这里填你为该账号设置的密码@127.0.0.1:3307/campusgo"

# ------------------------------------------------------------------
# 阶段3.3.3：以下全部可留空，注释里写的是后端实际使用的默认值。
# ------------------------------------------------------------------

# 日志级别：debug | info | warn | error。默认开发 debug、生产 info。
# LOG_LEVEL=debug

# 是否写文件日志 true | false。默认开发不落盘（只看控制台）、生产落盘。
# LOG_TO_FILE=false

# 日志目录：相对路径按 apps/server 解析。默认 apps/server/logs，文件名 app-YYYY-MM-DD.log。
# 该目录已在 .gitignore 里排除，不要把日志提交进仓库。
# LOG_DIR=logs

# 单个日志文件超过这个字节数就切分片（app-YYYY-MM-DD.1.log …）。默认 2097152（2MB）。
# LOG_MAX_BYTES=2097152

# 最多保留几个日志文件（含分片）。默认 5，取值范围 2—100。
# LOG_MAX_FILES=5

# 超过多少天的日志文件删掉。默认 7，取值范围 1—90。
# 三条加起来就是日志占用的上界：LOG_MAX_BYTES × LOG_MAX_FILES，日志不会无限增长。
# LOG_RETENTION_DAYS=7

# 这些路径的访问日志降到 debug（前端健康轮询太吵）。默认 /,/api/health,/api/health/database。
# LOG_QUIET_PATHS=/,/api/health,/api/health/database

# 请求体大小上限，支持 512kb / 1mb / 直接写字节数。默认 1mb。
# 超限返回 413 + PAYLOAD_TOO_LARGE，detail 里会带回当前生效的上限。
# BODY_LIMIT=1mb

# 是否启用接口频率限制 true | false。默认 true。
# RATE_LIMIT_ENABLED=true

# 频率限制窗口（毫秒）与单窗口内同一 IP 的最大请求数。窗口默认 60000。
# RATE_LIMIT_MAX 默认：开发 1200、生产 600。
# 开发取 1200 是实测出来的：全量 e2e 与截图脚本同时跑时，五个视口的健康轮询全算在 127.0.0.1 上，
# 60 秒峰值 233 次，600 只剩 2.6 倍余量，容易被自家测试打出 429；生产按真实用户分布，600 足够。
# 超额返回 429 + TOO_MANY_REQUESTS，并带 Retry-After。
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=1200

# ------------------------------------------------------------------
# 第三方 API 密钥（阶段6 天气接入）
# ------------------------------------------------------------------
# 以下密钥只在本机使用，严禁写入源代码、README、测试报告或提交进 Git。
# 本文件已在 .gitignore 的放行规则里（.env.* 被忽略、.env.example 例外）。

# 和风天气 API Key（后端调用，用于获取实时天气与预报）。
# 申请地址：https://console.qweather.com
# QWEATHER_API_KEY=

# 和风天气 API Host（专属域名，由和风提供，例如 devapi.qweather.com）。
# QWEATHER_API_HOST=
