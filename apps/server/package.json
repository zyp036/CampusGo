{
  "name": "@campusgo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "拾光CampusGo 后端（Node.js + Express + TypeScript）",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "tsx src/scripts/prisma-generate.ts",
    "prisma:validate": "prisma validate",
    "db:check": "tsx src/scripts/db-check.ts",
    "db:collation": "tsx src/scripts/db-collation.ts",
    "db:schema": "tsx src/scripts/db-schema-verify.ts",
    "probe:errors": "tsx src/scripts/error-probe.ts",
    "probe:validation": "tsx src/scripts/validation-probe.ts",
    "probe:security": "tsx src/scripts/security-probe.ts",
    "probe:logger": "tsx src/scripts/logger-probe.ts",
    "probe:data": "tsx src/scripts/data-probe.ts",
    "probe:persistence": "tsx src/scripts/persistence-probe.ts",
    "probe:user-base": "tsx src/scripts/user-base-probe.ts",
    "probe:identity": "tsx src/scripts/identity-probe.ts",
    "probe:preference": "tsx src/scripts/preference-probe.ts",
    "probe:favorites": "tsx src/scripts/favorite-probe.ts",
    "probe:tasks": "tsx src/scripts/task-probe.ts",
    "probe:badges": "tsx src/scripts/badge-probe.ts",
    "probe:memories": "tsx src/scripts/memory-probe.ts",
    "probe:activities": "tsx src/scripts/activity-probe.ts",
    "probe:progress": "tsx src/scripts/progress-probe.ts",
    "probe:auth": "tsx src/scripts/auth-probe.ts",
    "reconcile:cache": "tsx src/scripts/reconcile-user-cache.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
